{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheusroot.github.io/omarchy-plugin-security/schemas/v1/findings.schema.json",
  "title": "Finding",
  "description": "One ground-truth finding at path:line. Scanners are authoritative; source \"ai\" findings can never be hard-fails.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "ruleId", "severity", "confidence", "path", "line", "snippet", "message", "category", "hardFail"],
  "properties": {
    "id": { "$ref": "#/$defs/findingId" },
    "source": { "type": "string", "pattern": "^(ai|[a-z0-9][a-z0-9._-]{0,39})$", "description": "Scanner name (e.g. opengrep, heckler, gitleaks) or \"ai\"." },
    "ruleId": { "$ref": "#/$defs/ruleId" },
    "severity": { "$ref": "#/$defs/severity" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "path": { "type": "string", "maxLength": 512, "description": "Repo-relative POSIX path; \"\" for repo-level findings." },
    "line": { "type": "integer", "minimum": 0, "description": "1-based; 0 = file- or repo-level." },
    "endLine": { "type": "integer", "minimum": 0 },
    "snippet": { "type": "string", "maxLength": 400, "description": "Excerpt; secrets redacted; control chars escaped as \\u{XXXX}." },
    "message": { "type": "string", "minLength": 1, "maxLength": 500 },
    "category": { "$ref": "#/$defs/category" },
    "hardFail": { "type": "boolean" },
    "aiVerified": { "enum": ["confirmed", "likely-fp", "unsure"] }
  },
  "$defs": {
    "findingId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" },
    "ruleId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$" },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "category": { "enum": ["exec", "network", "persistence", "privilege", "obfuscation", "injection", "secret", "filesystem", "package", "supply-chain", "quality", "performance", "other"] }
  }
}
