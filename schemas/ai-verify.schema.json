{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prometheusroot.github.io/omarchy-plugin-security/schemas/v1/ai-verify.schema.json",
  "title": "AI verify pass 2",
  "description": "Structured output of Claude pass 2. Object root because --json-schema requires one; report.ai.pass2 stores the items.",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdicts"],
  "properties": {
    "verdicts": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "verdict", "reason"],
      "properties": {
        "findingId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" },
        "verdict": { "enum": ["confirmed", "likely-fp", "unsure"] },
        "reason": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
