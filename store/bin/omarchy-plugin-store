#!/usr/bin/env bash
# Launch the Omarchy plugin store: its own Quickshell process and floating 1280x800
# window (ADR-0014). Bind it to a key, e.g. super+shift+P.
#   omarchy-plugin-store [--dev]     --dev: fake install runner, sample installed list, `t` themes
# OPC_STORE_T0 (ms since epoch) lets the app report cold start from launch, not QML load.
set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
title="omarchy plugin store"

if [[ ${1:-} == "--dev" ]]; then
  export OPC_STORE_DEV=1
  shift
fi
OPC_STORE_T0=$(date +%s%3N)
export OPC_STORE_T0

# One store at a time: focus the running one instead.
if hyprctl clients -j 2> /dev/null | jq -e --arg t "$title" 'any(.[]; .title == $t)' > /dev/null; then
  addr=$(hyprctl clients -j | jq -r --arg t "$title" '.[] | select(.title == $t) | .address' | head -1)
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" > /dev/null 2>&1 \
    || hyprctl dispatch focuswindow "address:$addr" > /dev/null
  exit 0
fi

qs -n -p "$here" "$@" &

# Float + size + center once the toplevel maps (Lua dispatchers, legacy fallback).
dispatch() {
  hyprctl dispatch "$1" > /dev/null 2>&1 || hyprctl dispatch "${@:2}" > /dev/null 2>&1 || true
}
for _ in $(seq 1 60); do
  addr=$(hyprctl clients -j 2> /dev/null | jq -r --arg t "$title" '.[] | select(.title == $t) | .address' | head -1)
  if [[ -n $addr ]]; then
    w="address:$addr"
    floating=$(hyprctl clients -j | jq -r --arg a "$addr" '.[] | select(.address == $a) | .floating')
    if [[ $floating != "true" ]]; then
      dispatch "hl.dsp.window.float({ window = \"$w\", action = \"toggle\" })" togglefloating "$w"
    fi
    dispatch "hl.dsp.window.resize({ window = \"$w\", x = 1280, y = 800 })" resizewindowpixel "exact 1280 800,$w"
    dispatch "hl.dsp.window.center({ window = \"$w\" })" centerwindow "$w"
    break
  fi
  sleep 0.05
done
wait
