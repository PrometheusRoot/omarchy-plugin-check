---
// A provider row without an embedded report (the marketplace baseline, or a feed row that only
// carries the predicate), or no row at all: same three-column layout, fewer sections.
import { day, providerShort, STATE_ICON, sha7, TIER_NOTE, verdictState } from '../lib/model';
import { marketplaceUrl } from '../lib/render';
import type { PluginDoc, ProviderRow } from '../lib/types';
import Activity from './Activity.astro';
import Criteria from './Criteria.astro';
import Icon from './Icon.astro';
import MarketplaceCard from './MarketplaceCard.astro';
import Section from './Section.astro';

interface Props {
  doc: PluginDoc;
  row: ProviderRow | null;
}
const { doc, row } = Astro.props;
const base = import.meta.env.BASE_URL;
const p = row?.provider ?? 'none';
const sid = (s: string) => `sec-${p}-${s}`;
const l = doc.listing;
const isMkt = row?.provider === 'marketplace';
const s = row ? verdictState(row.verdict) : 'unreviewed';
const caps = Array.isArray(row?.detail?.capabilities) ? row.detail.capabilities : [];
const install = l?.install === '' ? null : (l?.install ?? `omarchy plugin add ${doc.repo}.git --enable`);
const nav = [
  ['verdict', 'i-gavel'],
  ['does', 'i-info'],
  ['activity', 'i-commit'],
  ...(row && !isMkt ? ([['findings', 'i-list']] as const) : []),
] as const;
---
<div class="rgrid">
  <nav class="rnav" aria-label="report sections">
    {
      nav.map(([id, ic]) => (
        <a href={`#${sid(id)}`} data-s={id}>
          <Icon id={ic} size="m" />
          {id}
        </a>
      ))
    }
  </nav>
  <div class="rmain">
    <Section id={sid('verdict')} title={row ? (isMkt ? 'marketplace baseline' : `${providerShort(row.provider)} verdict`) : 'not reviewed'} icon={row ? (row.verification === 'sigstore' ? 'i-sig' : 'i-unsig') : 'i-unreviewed'}>
      {
        row ? (
          <>
            <div class="row" style="gap:12px">
              <span class={`glyph c-${s}`}><Icon id={STATE_ICON[s]} size="l" /></span>
              <b class={`mono c-${s}`} style="font:500 24px/1 var(--mono)">{s}</b>
              <span class="chip sm tip" data-tip={TIER_NOTE[row.tier]}>{row.tier}</span>
              {row.verification !== 'sigstore' && row.tier !== 'unsigned' && <span class="chip sm dim">unsigned</span>}
            </div>
            {row.summary && <p>{row.summary}</p>}
            <dl class="kv">
              {isMkt && (
                <>
                  <dt>outcome</dt>
                  <dd>{String(row.detail?.outcome ?? '—')} <span class="mute">(marketplace automated baseline)</span></dd>
                  <dt>caps</dt>
                  <dd>{caps.length ? caps.map((c) => <span class="chip" style="margin-right:4px">{String(c)}</span>) : '—'}</dd>
                  <dt>mode</dt>
                  <dd>{String(row.detail?.enforcementMode ?? '—')}</dd>
                </>
              )}
              {!isMkt && (
                <>
                  <dt>criteria</dt>
                  <dd><Criteria criteria={row.criteria} /></dd>
                </>
              )}
              <dt>commit</dt>
              <dd class="mono">{sha7(row.commit)}</dd>
              <dt>checked</dt>
              <dd class="mono">{day(row.timeReviewed)}</dd>
              <dt>counts as</dt>
              <dd>{row.counted ? `${row.tier === 'unsigned' || row.tier === 'community' ? '≤' : ''}${verdictState(row.effectiveVerdict)}` : 'not counted'}</dd>
            </dl>
            {isMkt && (
              <p class="na">
                the marketplace publishes no findings, no score and no signature. it is the source of truth for metadata; for verdicts it can only raise combined to caution, never make it safe.
              </p>
            )}
          </>
        ) : (
          <p class="na">no provider has published a verdict for this plugin. install it only after reading the code, or wait for a review.</p>
        )
      }
    </Section>

    <Section id={sid('does')} title="does" icon="i-info" note="marketplace listing">
      {l?.desc && <p style="max-width:70ch">{l.desc}</p>}
      <dl class="kv">
        <dt>kind</dt>
        <dd>{l?.kind ?? '—'}</dd>
        <dt>version</dt>
        <dd class="mono">{l?.version ?? '—'}</dd>
        <dt>install</dt>
        <dd>
          {install ? (
            <>
              <code class="mono" style="font-size:12px">omarchy-plugin-check --add {doc.id}</code>
              <div class="mute" style="font-size:12px">checks the verdict first, then runs <code>{install}</code></div>
            </>
          ) : (
            <span class="mute">not installable via omarchy plugin add</span>
          )}
        </dd>
      </dl>
    </Section>

    <Section id={sid('activity')} title="activity" icon="i-commit" note="github">
      <Activity doc={doc} tiles={true} />
    </Section>

    {
      row && !isMkt && (
        <Section id={sid('findings')} title="findings" icon="i-list" note={`${(row.findings ?? []).length}`}>
          {(row.findings ?? []).length ? (
            <div class="findings">
              {(row.findings ?? []).map((f) => (
                <article class="find" style="--sc:var(--border-strong)">
                  <span class="sev"></span>
                  <div class="body">
                    <div class="row">
                      <span class={`chip c-${f.severity}`} style="border-color:currentColor">{f.severity}</span>
                      <span class="chip">{f.category}</span>
                      {f.blocking && <span class="chip hf">blocking</span>}
                      {(f.locations ?? []).slice(0, 3).map((loc) => (
                        <span class="loc">{loc.path}{loc.startLine ? `:${loc.startLine}` : ''}</span>
                      ))}
                    </div>
                    <div class="msg">{f.message}</div>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="na">no findings above info</p>
          )}
        </Section>
      )
    }
  </div>
  <aside class="raside" aria-label="listing details">
    <MarketplaceCard doc={doc} />
    <div class="card">
      <span class="lbl">data</span>
      <div class="row" style="gap:6px">
        <a class="chip" href={`${base}api/v1/plugins/${doc.id}.json`}>{doc.id}.json</a>
        <a class="chip" href={marketplaceUrl(doc.id)} rel="noopener">↗ marketplace</a>
      </div>
    </div>
  </aside>
</div>
